FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir duckdb==1.3.2 pyarrow==19.0.1
COPY pipelines/export_parquet.py /app/export_parquet.py
COPY pipelines/audit_batch.py /app/audit_batch.py
COPY pipelines /app/pipelines
COPY tests/test_audit_batch.py /app/tests/test_audit_batch.py
ENTRYPOINT ["python", "/app/export_parquet.py"]
